# --- Required for local development (no other keys are needed) ---
# Matches docker-compose.yml's postgres service credentials. DIRECT_DATABASE_URL is
# only meaningfully different from DATABASE_URL when the latter is a pooled
# connection (e.g. Neon in production) -- for local Postgres they're the same value.
DATABASE_URL="postgresql://ruach:ruach@localhost:5432/ruach_dev"
DIRECT_DATABASE_URL="postgresql://ruach:ruach@localhost:5432/ruach_dev"

# NextAuth v5 requires a secret for signing session tokens.
# Generate one locally with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional: only needed to exercise live/real integrations ---
# Leave unset to use MockAIProvider (deterministic, no network calls).
OPENAI_API_KEY=""

# Leave unset to use Mock YouTube/Vimeo providers.
YOUTUBE_API_KEY=""
VIMEO_ACCESS_TOKEN=""

# Shared secret for the auto-sync cron endpoint (app/api/cron/sync/route.ts).
# Required in any environment where auto-sync is used -- generate with:
# openssl rand -base64 32
CRON_SECRET=""

# Stripe billing. Leave unset to leave paid signup/upgrade non-functional (the
# free, invite-only tier via access codes still works without these).
# Secret key from the Stripe dashboard (use a *test-mode* key locally).
STRIPE_SECRET_KEY=""
# Signing secret Stripe (or `stripe listen`) gives you for the webhook endpoint.
STRIPE_WEBHOOK_SECRET=""
# Price IDs for the 3 paid tiers x 2 billing intervals. Generate real ones with:
# pnpm --filter @ruach/dashboard exec tsx scripts/stripe-setup.ts
STRIPE_PRICE_ESSENTIAL_MONTHLY=""
STRIPE_PRICE_ESSENTIAL_YEARLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_YEARLY=""
STRIPE_PRICE_MULTISITE_MONTHLY=""
STRIPE_PRICE_MULTISITE_YEARLY=""
# Customer portal configuration id (payment method + invoices only -- plan changes
# and cancellation are handled in-app instead). Only needed in production; test
# mode has its own default. Generate with:
# pnpm --filter @ruach/dashboard exec tsx scripts/stripe-portal-setup.ts
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# Vercel Blob (real object storage for logo uploads). Leave unset to fall back to
# LocalStorageProvider (disk-backed, fine for local dev, NOT suitable for any
# deployment with an ephemeral filesystem such as Vercel serverless functions).
BLOB_READ_WRITE_TOKEN=""

# Resend (real email delivery). Leave unset to fall back to ConsoleEmailProvider.
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN=""

# Sentry (error monitoring, free tier). Leave unset to disable -- the SDK is a no-op
# without a DSN, it won't throw. DSNs aren't secret (safe to ship in the client
# bundle), which is why this is NEXT_PUBLIC_ and shared across client/server/edge.
NEXT_PUBLIC_SENTRY_DSN=""
