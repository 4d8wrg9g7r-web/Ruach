// Ruach — milestone 1 schema.
// Every organization-owned model carries organizationId (brief §6). Billing/Subscription/
// UsageRecord tables are intentionally excluded until organization/website/widget/resource
// architecture is stable (brief instruction #25).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (darwin-arm64 etc.); rhel-openssl-3.0.x is what
  // Vercel's serverless functions actually run on at request time, which differs
  // from whatever OS ran `prisma generate` during the build step -- without this
  // explicit target the client builds fine but can't find its query engine at
  // runtime in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's DATABASE_URL is pooled (PgBouncer), which the migration engine can't
  // reliably run schema changes / advisory locks through -- directUrl routes
  // `prisma migrate` at the unpooled connection while the generated client still
  // uses the pooled url above at runtime.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  createdAccessCodes  FreeTierAccessCode[] @relation("AccessCodeCreatedBy")
  usedAccessCode      FreeTierAccessCode?  @relation("AccessCodeUsedBy")
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreatedBy")
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/**
 * Single-use, admin-issued code that waives payment for one signup, creating a
 * free-tier org -- deliberately NOT named "invite": that word already means "add a
 * teammate to my existing org" everywhere else in this codebase (team-service.ts).
 * Not tenant-scoped (predates any organization existing).
 */
model FreeTierAccessCode {
  id              String    @id @default(cuid())
  code            String    @unique
  note            String?
  createdByUserId String
  usedByUserId    String?   @unique
  usedAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  createdBy User  @relation("AccessCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy    User? @relation("AccessCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
}

/**
 * Single-use, short-lived (see forgot-password.ts's TTL constant) -- a fresh request invalidates any prior unused token for the same user rather than allowing several to be valid at once.
 */
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  CONTENT_MANAGER
  ANALYTICS_VIEWER
  // Scoped to exactly one function: the prayer moderation page and nothing else --
  // see requirePrayerModeratorAccess in lib/session.ts. Only assignable from the
  // team-invite role picker on plans with the advancedRolesPermissions feature.
  PRAYER_MODERATOR
}

// ---------------------------------------------------------------------------
// Marketing site
// ---------------------------------------------------------------------------

/**
 * "Request a Demo" form submissions (apps/dashboard/app/(marketing)/demo) --
 * pre-account, so there's no organizationId to scope by. Not tenant-scoped; excluded
 * from the tenant-guard the same way FreeTierAccessCode is.
 */
model DemoRequest {
  id                String   @id @default(cuid())
  name              String
  churchName        String
  role              String
  email             String
  churchWebsite     String?
  attendanceRange   String
  campusCount       String?
  currentPlatform   String?
  contentPlatforms  String?
  message           String?
  preferredContact  String?
  createdAt         DateTime @default(now())
}

model Organization {
  id                            String              @id @default(cuid())
  name                          String
  slug                          String              @unique
  categorizationMode            CategorizationMode  @default(ASSISTED)
  prayerWallEnabled             Boolean             @default(false)
  publicPrayerWallId            String              @unique @default(cuid())
  // A plain list, not a join table -- just a set of addresses with no other
  // attributes. Essential/free are capped at 1 entry (enforced in the Settings
  // Server Action); prayerTeamNotifications entitles more.
  prayerRequestForwardingEmails String[]            @default([])
  prayerWallBrandColor          String?
  prayerWallLogoUrl             String?
  // planKey resolves into the PLANS map in billing-service.ts, not a DB table --
  // see that file's doc comment. The default exists only to backfill pre-billing
  // rows during migration; every real creation path (Stripe webhook, access-code
  // redemption) sets it explicitly.
  planKey                       String              @default("essential")
  stripeCustomerId              String?             @unique
  stripeSubscriptionId          String?             @unique
  subscriptionStatus            SubscriptionStatus?
  billingInterval               BillingInterval?
  currentPeriodEnd              DateTime?
  // True once Cancel plan has been confirmed -- the subscription stays ACTIVE and
  // fully usable through currentPeriodEnd, then Stripe's subscription.deleted event
  // flips subscriptionStatus to CANCELED. Resume plan just sets this back to false
  // before the period ends.
  cancelAtPeriodEnd             Boolean             @default(false)
  // Usage-warning email dedup (lib/usage-warnings.ts): compared against the current
  // billing period's start on each cron run rather than explicitly reset, so a
  // null/stale timestamp just means "eligible to send again this period."
  usageWarning75SentAt          DateTime?
  usageWarning90SentAt          DateTime?
  // Explicit dismissal of the guided-onboarding checklist (Dashboard Overview) --
  // completion itself is computed live from existing counts (websites/widgets/
  // resources/conversations), not stored. Null just means "not dismissed yet"; the
  // checklist also auto-hides once every step is complete, dismissed or not.
  onboardingChecklistDismissedAt DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  members                 OrganizationMember[]
  websites                Website[]
  widgets                 WidgetConfiguration[]
  resources               Resource[]
  resourceSourceDocuments ResourceSourceDocument[]
  generatedEvidence       GeneratedMetadataEvidence[]
  collections             Collection[]
  resourceCollections     ResourceCollection[]
  actionLinks             ActionLink[]
  importJobs              ImportJob[]
  importJobItems          ImportJobItem[]
  bulkJobs                BulkJob[]
  conversations           Conversation[]
  conversationMessages    ConversationMessage[]
  auditLogs               AuditLog[]
  contentSources          ContentSource[]
  prayerWallAccounts      PrayerWallAccount[]
  prayerRequests          PrayerRequest[]
  prayerWallResetTokens   PrayerWallPasswordResetToken[]
  people                  Person[]
  households              Household[]
  personRelationships     PersonRelationship[]
  groups                  Group[]
  groupMemberships        GroupMembership[]
  forms                   FormDefinition[]
  formVersions            FormVersion[]
  formSubmissions         FormSubmission[]
  outboxEvents            OutboxEvent[]
  processedEvents         ProcessedEvent[]
  workflows               WorkflowDefinition[]
  workflowVersions        WorkflowVersion[]
  workflowRuns            WorkflowRun[]
  tasks                   Task[]
}

enum CategorizationMode {
  MANUAL
  ASSISTED
  AUTOMATIC
}

/**
 * userId is @unique, not just part of a compound key -- product decision: one
 * organization per user account, no multi-org membership/switching (see
 * lib/session.ts's getCurrentOrganization). A row's own id is still the primary
 * key so this stays a normal join table shape rather than making userId the PK.
 */
model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String           @unique
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Websites & Widgets
// ---------------------------------------------------------------------------

enum WebsiteStatus {
  ACTIVE
  INACTIVE
}

model Website {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  primaryDomain  String
  allowedDomains String[]      @default([])
  stagingDomains String[]      @default([])
  status         WebsiteStatus @default(ACTIVE)
  // Campus-specific prayer wall (Multi-Site+ only, campusScopedPrayerWalls feature).
  // Mirrors Organization's 5 prayer-wall fields exactly -- the org-level wall stays
  // the default/fallback for every org unchanged; these are an additive per-campus
  // option, not a replacement. publicPrayerWallId is nullable+unique (not every
  // website has its own wall) unlike Organization's always-present version.
  prayerWallEnabled             Boolean  @default(false)
  publicPrayerWallId            String?  @unique
  prayerRequestForwardingEmails String[] @default([])
  prayerWallBrandColor          String?
  prayerWallLogoUrl             String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets        WidgetConfiguration[]
  resources      Resource[]
  prayerRequests PrayerRequest[]
  people         Person[]
  groups         Group[]

  @@index([organizationId])
}

enum WidgetStatus {
  ACTIVE
  INACTIVE
}

enum LauncherPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

model WidgetConfiguration {
  id                        String           @id @default(cuid())
  organizationId            String
  websiteId                 String
  name                      String
  publicWidgetId            String           @unique @default(cuid())
  status                    WidgetStatus     @default(ACTIVE)
  assistantName             String           @default("Resource Assistant")
  welcomeMessage            String           @default("Hi! What are you looking for today?")
  inputPlaceholder          String           @default("Ask a question...")
  launcherLabel             String           @default("Ask a question")
  launcherPosition          LauncherPosition @default(BOTTOM_RIGHT)
  primaryColor              String           @default("#161616")
  logoUrl                   String?
  suggestedPrompts          String[]         @default([])
  privacyNotice             String           @default("Conversations are anonymous and not linked to your identity.")
  noResultMessage           String           @default("I couldn't find a resource that directly addresses that yet.")
  maxRecommendations        Int              @default(3)
  allowInlinePlayback       Boolean          @default(true)
  showPlatformBranding      Boolean          @default(true)
  conversationRetentionDays Int              @default(30)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([organizationId])
  @@index([websiteId])
}

// ---------------------------------------------------------------------------
// Resources
// ---------------------------------------------------------------------------

enum ResourceType {
  VIDEO
  SERMON
  PODCAST
  ARTICLE
  COURSE
  DOCUMENT
  DEVOTIONAL
  AUDIO
  OTHER
}

enum ResourceStatus {
  DRAFT
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  ACTIVE
  INACTIVE
  FAILED
  ARCHIVED
}

enum ResourceProviderType {
  YOUTUBE
  VIMEO
  SUBSPLASH
  GENERIC_URL
  MANUAL
  RSS
}

enum TranscriptSource {
  PROVIDER_CAPTIONS
  UPLOADED_CAPTIONS
  MANUAL_TRANSCRIPT
  LINKED_NOTES
  AUTOMATIC_TRANSCRIPTION
  METADATA_ONLY
}

model Resource {
  id             String         @id @default(cuid())
  organizationId String
  // null = org-wide, available to every campus's widgets (the default for every org
  // today). Set = scoped to one campus/website's content library only -- Multi-Site+
  // only (campusScopedContentLibraries feature); see the retrieval provider's
  // candidate-resource filtering. onDelete: SetNull, not Cascade -- deleting a
  // website should never delete the org's resources, just unscope them back to
  // org-wide.
  websiteId      String?
  resourceType   ResourceType
  status         ResourceStatus @default(DRAFT)

  title       String
  subtitle    String?
  description String?
  summary     String?

  creatorName     String?
  speakerName     String?
  seriesTitle     String?
  publishedAt     DateTime?
  durationSeconds Int?
  thumbnailUrl    String?
  publicUrl       String
  embedUrl        String?

  sourceProvider ResourceProviderType
  externalId     String

  transcript       String?
  cleanTranscript  String?
  transcriptSource TranscriptSource?

  topics            String[] @default([])
  primaryTopic      String?
  secondaryTopics   String[] @default([])
  scriptures        String[] @default([])
  questionsAnswered String[] @default([])
  audiences         String[] @default([])
  lifeSituations    String[] @default([])
  keyTakeaways      String[] @default([])

  searchDocument String?
  contentHash    String?
  lastIndexedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website         Website?                    @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  sourceDocuments ResourceSourceDocument[]
  evidence        GeneratedMetadataEvidence[]
  collections     ResourceCollection[]
  importJobItems  ImportJobItem[]

  @@unique([organizationId, sourceProvider, externalId])
  @@index([organizationId, status])
  @@index([websiteId])
}

enum SourceDocumentType {
  VIDEO_DESCRIPTION
  PROVIDER_METADATA
  TRANSCRIPT
  CAPTION_FILE
  SERMON_NOTES
  PDF
  WEB_PAGE
  MANUAL_NOTES
  OTHER
}

model ResourceSourceDocument {
  id                      String             @id @default(cuid())
  organizationId          String
  resourceId              String
  sourceType              SourceDocumentType
  sourceUrl               String?
  fileName                String?
  originalText            String?
  cleanText               String?
  includedInAnalysis      Boolean            @default(true)
  approvedByUser          Boolean            @default(false)
  discoveredAutomatically Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource                    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  evidence     GeneratedMetadataEvidence[]

  @@index([organizationId])
  @@index([resourceId])
}

model GeneratedMetadataEvidence {
  id               String   @id @default(cuid())
  organizationId   String
  resourceId       String
  fieldName        String
  generatedValue   String
  sourceDocumentId String?
  sourceExcerpt    String?
  confidenceScore  Float
  createdAt        DateTime @default(now())

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       Resource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sourceDocument ResourceSourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([resourceId])
}

model Collection {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    ResourceCollection[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ResourceCollection {
  organizationId String
  resourceId     String
  collectionId   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([resourceId, collectionId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Imports
// ---------------------------------------------------------------------------

enum ImportType {
  SINGLE
  PLAYLIST
  CHANNEL
  MANUAL
  FEED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model ImportJob {
  id             String               @id @default(cuid())
  organizationId String
  provider       ResourceProviderType
  importType     ImportType
  status         ImportJobStatus      @default(PENDING)
  totalItems     Int                  @default(0)
  successCount   Int                  @default(0)
  failureCount   Int                  @default(0)
  errorLog       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ImportJobItem[]

  @@index([organizationId])
}

model ImportJobItem {
  id             String   @id @default(cuid())
  organizationId String
  importJobId    String
  resourceId     String?
  sourceUrl      String
  success        Boolean  @default(false)
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importJob    ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  resource     Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([importJobId])
}

enum BulkJobType {
  ANALYZE
  APPROVE
  REJECT
  DELETE
  FIND_LINKS
  INCLUDE_LINKS
}

enum BulkJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/**
 * Tracks a Resources-page bulk-toolbar action (one row per click, not per resource)
 * so the Server Action that enqueues it can return immediately -- the actual work
 * runs after the response via next/server's after(), and the client polls this row's
 * progress instead of the request blocking until every resource is processed. No
 * child item table: the existing per-action AuditLog entry already records
 * resourceIds, and the UI only needs an aggregate progress bar + one summary line.
 */
model BulkJob {
  id              String        @id @default(cuid())
  organizationId  String
  type            BulkJobType
  status          BulkJobStatus @default(PENDING)
  resourceIds     String[]
  totalCount      Int
  processedCount  Int           @default(0)
  successCount    Int           @default(0)
  failureCount    Int           @default(0)
  // Exactly which of resourceIds are done so far -- not derivable from processedCount
  // alone once work resumes across multiple chunked invocations (see
  // resource-pipeline.ts's runBulkJob), since concurrent workers can finish items out
  // of resourceIds' original order.
  processedResourceIds String[] @default([])
  // FIND_LINKS/INCLUDE_LINKS-specific running total (links discovered / links
  // included) folded into resultSummary once the job fully completes -- generic
  // rather than two separate fields since only one job type's summary needs it at a
  // time.
  extraCount      Int           @default(0)
  resultSummary   String?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}

/**
 * A tracked YouTube channel or RSS feed that should be periodically re-checked for
 * new content. provider is restricted at the service layer to YOUTUBE | RSS (the two
 * providers with listResources()/bulk import support) even though it reuses the
 * broader ResourceProviderType enum. Sync itself reruns the same
 * importYouTubeChannel/importRSSFeed bulk-import path used for the one-off import
 * forms, so re-imported items are deduped the same way (organizationId +
 * sourceProvider + externalId).
 */
model ContentSource {
  id              String               @id @default(cuid())
  organizationId  String
  provider        ResourceProviderType
  sourceUrl       String
  label           String?
  autoSyncEnabled Boolean              @default(true)
  autoApprove     Boolean              @default(false)
  lastSyncedAt    DateTime?
  lastSyncStatus  ImportJobStatus?
  lastSyncError   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, sourceUrl])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  widgetId       String
  sessionId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widget       WidgetConfiguration   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]

  @@index([organizationId])
  @@index([widgetId, sessionId])
}

enum MessageRole {
  USER
  ASSISTANT
}

model ConversationMessage {
  id                     String      @id @default(cuid())
  organizationId         String
  conversationId         String
  role                   MessageRole
  content                String
  responseType           String?
  recommendedResourceIds String[]    @default([])
  createdAt              DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Actions, Audit
// ---------------------------------------------------------------------------

model ActionLink {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  type           String
  url            String
  icon           String?
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Prayer wall
// ---------------------------------------------------------------------------

/**
 * A public-site visitor's account, scoped to one organization -- the same email can have separate accounts at different churches.
 */
model PrayerWallAccount {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  displayName    String?
  createdAt      DateTime @default(now())

  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       PrayerWallSession[]
  prayerRequests PrayerRequest[]
  resetTokens    PrayerWallPasswordResetToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

/**
 * Opaque bearer-token session for a PrayerWallAccount. Deliberately NOT tenant-scoped
 * (no organizationId column) -- the token itself is the lookup key used to resolve
 * identity before any organizationId is known, the same boundary as User/
 * getWidgetByPublicId. Accessed only via rawDb in prayer-service.ts.
 */
model PrayerWallSession {
  id        String   @id @default(cuid())
  accountId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  account PrayerWallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/**
 * Unlike PrayerWallSession, this IS tenant-scoped (organizationId present, queried via
 * tenantDb) -- the reset flow always starts from /prayer/[publicPrayerWallId]/..., so
 * the organization is already known before a token is ever issued or looked up, none
 * of the "resolve identity before organizationId is known" bootstrapping problem
 * PrayerWallSession has. Single-use and short-lived, same as PasswordResetToken.
 */
model PrayerWallPasswordResetToken {
  id             String   @id @default(cuid())
  organizationId String
  accountId      String
  token          String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      PrayerWallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([accountId])
}

enum PrayerRequestStatus {
  SUBMITTED
  ANSWERED
}

// Fixed set for v1, not per-org customizable -- see the plan doc's explicit
// non-goal. Only offered on the public submit form when the org's plan has the
// prayerCategories feature; otherwise the field stays null.
enum PrayerRequestCategory {
  HEALTH
  FAMILY
  FINANCIAL
  SPIRITUAL_GROWTH
  GRIEF_LOSS
  GUIDANCE
  OTHER
}

model PrayerRequest {
  id             String                 @id @default(cuid())
  organizationId String
  accountId      String
  // null = submitted via the org-level default wall. Set = submitted via a specific
  // campus's wall (Website.prayerWallEnabled) -- determines which campus's forwarding
  // emails fire and which public wall page lists it. onDelete: SetNull, not Cascade --
  // deleting a website's wall config should never delete the requests made through it.
  websiteId      String?
  message        String
  isPublic       Boolean                @default(false)
  isAnonymous    Boolean                @default(false)
  publicizedAt   DateTime?
  status         PrayerRequestStatus    @default(SUBMITTED)
  category       PrayerRequestCategory?
  // Staff-only, never rendered on any public/submitter-facing page -- set via the
  // prayer moderation page (requires internalPrayerNotes entitlement).
  internalNotes  String?
  prayerCount    Int                    @default(0)
  answeredAt     DateTime?
  forwardedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      PrayerWallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  website      Website?          @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([accountId])
  @@index([websiteId])
}

// ---------------------------------------------------------------------------
// People & Households
//
// The canonical Person primitive (BLUEPRINT §5, non-negotiable principle #1 "One
// Person model"). Every future ministry module -- Giving, Groups, Check-In,
// Communications, HR, Services -- references this same Person rather than creating
// its own people records. A Person is a ministry record and is deliberately separate
// from User (the authentication identity): most people a church tracks never log in.
// See docs/domain/people.md.
// ---------------------------------------------------------------------------

enum MembershipStatus {
  VISITOR
  ATTENDER
  MEMBER
  INACTIVE
}

// A member's structural role within a household, distinct from any ministry role.
// Drives child-vs-adult treatment (relevant later to Check-In / child safety).
enum HouseholdRole {
  ADULT
  CHILD
  OTHER
}

// The type of `relatedPerson` relative to `person`: a row (person=Alice,
// related=Bob, type=CHILD) reads "Bob is Alice's child." Relationships are stored
// bidirectionally (see people-service.addRelationship / inverseRelationshipType).
enum PersonRelationshipType {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  GUARDIAN
  OTHER
}

model Household {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  // Soft archival, not delete -- ministry records keep history (BLUEPRINT §36).
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      Person[]

  @@index([organizationId])
}

model Person {
  id             String  @id @default(cuid())
  organizationId String
  // Household membership is optional -- a Person can exist unattached. onDelete:
  // SetNull so removing a household never deletes its people, just unlinks them.
  householdId    String?
  householdRole  HouseholdRole?
  // Home campus. Reuses the existing Website-as-campus convention rather than
  // introducing a duplicate Campus primitive (Constitution rule #1; see
  // docs/domain/people.md "Unresolved risks"). Mirrors Resource.websiteId exactly:
  // null = org-wide, onDelete: SetNull.
  campusWebsiteId String?

  firstName     String
  lastName      String
  preferredName String?
  // Contact email is distinct from any linked User's login email (BLUEPRINT §33).
  email         String?
  phone         String?

  membershipStatus MembershipStatus @default(VISITOR)
  birthdate        DateTime?
  tags             String[]         @default([])
  notes            String?

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household         Household?           @relation(fields: [householdId], references: [id], onDelete: SetNull)
  campus            Website?             @relation(fields: [campusWebsiteId], references: [id], onDelete: SetNull)
  relationshipsFrom PersonRelationship[] @relation("PersonRelationshipFrom")
  relationshipsTo   PersonRelationship[] @relation("PersonRelationshipTo")
  groupMemberships  GroupMembership[]
  formSubmissions   FormSubmission[]
  workflowRuns      WorkflowRun[]
  tasks             Task[]

  @@index([organizationId])
  @@index([organizationId, lastName])
  @@index([householdId])
  @@index([campusWebsiteId])
}

model PersonRelationship {
  id              String                 @id @default(cuid())
  organizationId  String
  personId        String
  relatedPersonId String
  type            PersonRelationshipType
  createdAt       DateTime               @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person        Person       @relation("PersonRelationshipFrom", fields: [personId], references: [id], onDelete: Cascade)
  relatedPerson Person       @relation("PersonRelationshipTo", fields: [relatedPersonId], references: [id], onDelete: Cascade)

  // One row per directed (person, related, type) triple -- addRelationship writes the
  // inverse row separately so both people see the tie.
  @@unique([personId, relatedPersonId, type])
  @@index([organizationId])
  @@index([personId])
  @@index([relatedPersonId])
}

// ---------------------------------------------------------------------------
// Groups
//
// Community, discipleship, and team grouping (BLUEPRINT §8). The first module to
// compose the Person primitive: a GroupMembership links an existing Person to a Group
// rather than storing its own copy of contact data. See docs/domain/groups.md.
// ---------------------------------------------------------------------------

enum GroupType {
  SMALL_GROUP
  CLASS
  MINISTRY_TEAM
  SERVING_TEAM
  OTHER
}

// How people join. Enforcement of REQUEST/INVITE_ONLY flows is deferred (v1 tracks the
// intent; staff add members directly); OPEN vs CLOSED informs the group finder.
enum GroupEnrollment {
  OPEN
  REQUEST
  INVITE_ONLY
  CLOSED
}

enum GroupMembershipRole {
  LEADER
  CO_LEADER
  MEMBER
}

model Group {
  id              String          @id @default(cuid())
  organizationId  String
  name            String
  type            GroupType       @default(SMALL_GROUP)
  description     String?
  enrollment      GroupEnrollment @default(OPEN)
  meetingSchedule String?
  meetingLocation String?
  // null = unlimited. Enforced in group-service.addMember (see hasCapacity).
  capacity        Int?
  // Group-finder visibility. Publishing a group makes it eligible for public/member
  // surfaces without duplicate entry (BLUEPRINT §8 "group finder publishing").
  isPublished     Boolean         @default(false)
  // Home campus -- reuses the Website-as-campus convention, mirroring Person/Resource.
  campusWebsiteId String?
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Website?          @relation(fields: [campusWebsiteId], references: [id], onDelete: SetNull)
  memberships  GroupMembership[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([campusWebsiteId])
}

model GroupMembership {
  id             String              @id @default(cuid())
  organizationId String
  groupId        String
  personId       String
  role           GroupMembershipRole @default(MEMBER)
  joinedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  // One membership per person per group.
  @@unique([groupId, personId])
  @@index([organizationId])
  @@index([groupId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Forms
//
// A church-aware form builder (BLUEPRINT §7). Built as a shared primitive so other
// modules reuse it instead of inventing bespoke intake forms. Schemas are VERSIONED:
// each publish snapshots an immutable FormVersion, and every FormSubmission records the
// version it was answered against, so historical submissions stay interpretable after a
// form changes. Submissions can match or create a Person. Field definitions live in JSON
// (genuinely flexible data, BLUEPRINT §36), validated by the pure forms/schema.ts.
// See docs/domain/forms.md.
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model FormDefinition {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  description    String?
  // Public URL key -- resolves a form without tenant context, the same bootstrapping
  // boundary as WidgetConfiguration.publicWidgetId / Organization.publicPrayerWallId.
  publicId       String     @unique @default(cuid())
  status         FormStatus @default(DRAFT)
  // The working field list being edited. Goes live to submitters only on publish, which
  // snapshots it into a FormVersion.
  draftSchema    Json       @default("[]")
  // The FormVersion.version currently served to submitters (null until first publish).
  publishedVersion Int?
  confirmationMessage String @default("Thanks! Your response has been received.")
  // When true, a submission with mapped name/email fields matches an existing Person by
  // email (case-insensitive, within org) or creates a new one.
  createPeople   Boolean    @default(true)
  // Staff addresses notified on each submission. Notification is delivered by the outbox
  // worker (FormSubmitted handler), not inline -- an empty list means no notification.
  notificationEmails String[] @default([])
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FormVersion[]
  submissions  FormSubmission[]

  @@index([organizationId])
}

model FormVersion {
  id             String   @id @default(cuid())
  organizationId String
  formId         String
  version        Int
  // Immutable snapshot of the field list at publish time.
  schema         Json
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, version])
  @@index([organizationId])
  @@index([formId])
}

model FormSubmission {
  id             String   @id @default(cuid())
  organizationId String
  formId         String
  // Which FormVersion.version this was answered against -- render it back against that
  // exact schema, never the current draft.
  version        Int
  // Answers keyed by field id.
  data           Json
  // Person matched or created from mapped fields (null if createPeople is off or no
  // mappable fields were present). SetNull so deleting a Person never deletes the
  // historical submission.
  personId       String?
  submitterEmail String?
  submitterName  String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  person       Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([formId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Transactional outbox
//
// Domain facts recorded in the SAME transaction as the state change that produced them
// (BLUEPRINT §38), then processed after commit by a durable worker with retries and
// per-handler idempotency. This is the foundation the workflow engine (§39) will run on.
// These are infrastructure tables, touched only by outbox-service (via rawDb, with
// explicit organization context) -- deliberately NOT in the app-facing tenant guard, the
// same treatment as PrayerWallSession. See docs/domain/outbox.md.
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  // Optional caller-supplied key to make emission idempotent (unique per org).
  dedupeKey      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId])
}

model ProcessedEvent {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  handler        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // At-most-once per (event, handler) even under duplicate delivery.
  @@unique([eventId, handler])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Workflow engine
//
// User-configurable trigger → condition → action automation (BLUEPRINT §39), running on
// the transactional outbox. Definitions are VERSIONED like forms: publishing snapshots an
// immutable WorkflowVersion, and every run pins the version it started with — re-
// publishing never changes an in-flight run. Config JSON (conditions + steps) is
// interpreted solely by the pure workflows/config.ts. Runs keep a step-by-step timeline
// in `log` so every automated action is explainable (§27). See docs/domain/workflows.md.
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowDefinition {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  // Trigger event type, e.g. "FormSubmitted" | "PersonCreated".
  trigger        String
  // Narrows FormSubmitted to one form (null = any form). Deliberately NOT a foreign key:
  // an FK with SetNull would silently broaden a deleted form's workflows to "any form".
  // A dangling id simply never matches again, which is the safe failure mode.
  triggerFormId  String?
  // Working conditions+steps being edited; goes live only on publish.
  draftConfig    Json           @default("{}")
  publishedVersion Int?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  runs         WorkflowRun[]

  @@index([organizationId])
  @@index([organizationId, status, trigger])
}

model WorkflowVersion {
  id             String   @id @default(cuid())
  organizationId String
  workflowId     String
  version        Int
  // Immutable snapshot of {conditions, steps} at publish time.
  config         Json
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([organizationId])
}

model WorkflowRun {
  id             String            @id @default(cuid())
  organizationId String
  workflowId     String
  // The WorkflowVersion.version this run executes — pinned at creation (§39 Versioning).
  version        Int
  status         WorkflowRunStatus @default(PENDING)
  // Index of the next step to execute.
  currentStep    Int               @default(0)
  // Attempts at the CURRENT step; reset to 0 when a step completes.
  attempts       Int               @default(0)
  // When this run is next due (WAIT target or retry backoff).
  nextStepAt     DateTime          @default(now())
  // Trigger context the conditions/steps evaluate over (event payload + derived fields).
  context        Json
  // Step-by-step timeline: [{step, type, status, at, detail?}] (§39 Observability).
  log            Json              @default("[]")
  personId       String?
  triggeredByEventId String?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  person       Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdTasks Task[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([status, nextStepAt])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Tasks
//
// The universal work primitive (BLUEPRINT §26/§40). HR onboarding, facilities, pastoral
// follow-up, and event planning compose this one engine; workflows create tasks through
// the CREATE_TASK step and those tasks retain workflowRunId so users can see why they
// exist (§40). Related entities start with Person; other relations arrive as additive
// nullable FKs alongside the modules that need them. See docs/domain/tasks.md.
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(NORMAL)
  dueAt          DateTime?
  // Assignee is a staff User (must be an OrganizationMember; enforced in task-service).
  // Team/Person assignees are a documented v1 non-goal.
  assigneeUserId String?
  // The record this work is about. SetNull: deleting a person never deletes work history.
  relatedPersonId String?
  // Workflow provenance (§40) -- set only for CREATE_TASK-created tasks.
  workflowRunId  String?
  createdByUserId String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee      User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  relatedPerson Person?      @relation(fields: [relatedPersonId], references: [id], onDelete: SetNull)
  workflowRun   WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, assigneeUserId])
  @@index([relatedPersonId])
  @@index([workflowRunId])
}
