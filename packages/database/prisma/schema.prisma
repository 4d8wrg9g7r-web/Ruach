// Ruach — milestone 1 schema.
// Every organization-owned model carries organizationId (brief §6). Billing/Subscription/
// UsageRecord tables are intentionally excluded until organization/website/widget/resource
// architecture is stable (brief instruction #25).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (darwin-arm64 etc.); rhel-openssl-3.0.x is what
  // Vercel's serverless functions actually run on at request time, which differs
  // from whatever OS ran `prisma generate` during the build step -- without this
  // explicit target the client builds fine but can't find its query engine at
  // runtime in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's DATABASE_URL is pooled (PgBouncer), which the migration engine can't
  // reliably run schema changes / advisory locks through -- directUrl routes
  // `prisma migrate` at the unpooled connection while the generated client still
  // uses the pooled url above at runtime.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  createdAccessCodes  FreeTierAccessCode[] @relation("AccessCodeCreatedBy")
  usedAccessCode      FreeTierAccessCode?  @relation("AccessCodeUsedBy")
  createdTestimonies  Testimony[]
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/**
 * Single-use, admin-issued code that waives payment for one signup, creating a
 * free-tier org -- deliberately NOT named "invite": that word already means "add a
 * teammate to my existing org" everywhere else in this codebase (team-service.ts).
 * Not tenant-scoped (predates any organization existing).
 */
model FreeTierAccessCode {
  id              String    @id @default(cuid())
  code            String    @unique
  note            String?
  createdByUserId String
  usedByUserId    String?   @unique
  usedAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  createdBy User  @relation("AccessCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy    User? @relation("AccessCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
}

/**
 * Single-use, short-lived (see forgot-password.ts's TTL constant) -- a fresh request invalidates any prior unused token for the same user rather than allowing several to be valid at once.
 */
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  CONTENT_MANAGER
  ANALYTICS_VIEWER
  // Scoped to exactly one function: the prayer moderation page and nothing else --
  // see requirePrayerModeratorAccess in lib/session.ts. Only assignable from the
  // team-invite role picker on plans with the advancedRolesPermissions feature.
  PRAYER_MODERATOR
}

// ---------------------------------------------------------------------------
// Marketing site
// ---------------------------------------------------------------------------

/**
 * "Request a Demo" form submissions (apps/dashboard/app/(marketing)/demo) --
 * pre-account, so there's no organizationId to scope by. Not tenant-scoped; excluded
 * from the tenant-guard the same way FreeTierAccessCode is.
 */
model DemoRequest {
  id                String   @id @default(cuid())
  name              String
  churchName        String
  role              String
  email             String
  churchWebsite     String?
  attendanceRange   String
  campusCount       String?
  currentPlatform   String?
  contentPlatforms  String?
  message           String?
  preferredContact  String?
  createdAt         DateTime @default(now())
}

model Organization {
  id                            String              @id @default(cuid())
  name                          String
  slug                          String              @unique
  categorizationMode            CategorizationMode  @default(ASSISTED)
  // Null = no priority, natural relevance-score ranking (today's behavior). Set to
  // one of ResourceTypeGroup's keys ("VIDEOS", "PODCASTS", "ARTICLES", "DOCUMENTS")
  // to make ChatPipeline's ranking step sort every matching-type candidate ahead of
  // every non-matching one, regardless of relevance score -- "no matter what, a
  // video on faith outranks a blog post or podcast on faith." Stored as a plain
  // string, not an enum column, so ResourceTypeGroup can stay a shared-types-only
  // concept without a matching Prisma enum to keep in sync.
  priorityContentType           String?
  prayerWallEnabled             Boolean             @default(false)
  publicPrayerWallId            String              @unique @default(cuid())
  // A plain list, not a join table -- just a set of addresses with no other
  // attributes. Essential/free are capped at 1 entry (enforced in the Settings
  // Server Action); prayerTeamNotifications entitles more.
  prayerRequestForwardingEmails String[]            @default([])
  prayerWallBrandColor          String?
  prayerWallLogoUrl             String?
  // Testimonies ("Praise Report" by default) are a sub-feature of the same prayer
  // wall -- same publicPrayerWallId page, branding, and visitor login, so no
  // separate brand color/logo/URL fields are needed here, just an enable toggle and
  // an admin-chosen display name for the page's nav link.
  testimoniesEnabled            Boolean             @default(false)
  testimoniesPageName           String              @default("Praise Report")
  // planKey resolves into the PLANS map in billing-service.ts, not a DB table --
  // see that file's doc comment. The default exists only to backfill pre-billing
  // rows during migration; every real creation path (Stripe webhook, access-code
  // redemption) sets it explicitly.
  planKey                       String              @default("essential")
  stripeCustomerId              String?             @unique
  stripeSubscriptionId          String?             @unique
  subscriptionStatus            SubscriptionStatus?
  billingInterval               BillingInterval?
  currentPeriodEnd              DateTime?
  // True once Cancel plan has been confirmed -- the subscription stays ACTIVE and
  // fully usable through currentPeriodEnd, then Stripe's subscription.deleted event
  // flips subscriptionStatus to CANCELED. Resume plan just sets this back to false
  // before the period ends.
  cancelAtPeriodEnd             Boolean             @default(false)
  // Usage-warning email dedup (lib/usage-warnings.ts): compared against the current
  // billing period's start on each cron run rather than explicitly reset, so a
  // null/stale timestamp just means "eligible to send again this period."
  usageWarning75SentAt          DateTime?
  usageWarning90SentAt          DateTime?
  // Explicit dismissal of the guided-onboarding checklist (Dashboard Overview) --
  // completion itself is computed live from existing counts (websites/widgets/
  // resources/conversations), not stored. Null just means "not dismissed yet"; the
  // checklist also auto-hides once every step is complete, dismissed or not.
  onboardingChecklistDismissedAt DateTime?
  // Controls only the auto-redirect into /onboarding/setup right after signup, not
  // step-by-step progress within the wizard -- that's derived from real data
  // (website/widget/resource counts), same pattern as onboardingChecklistDismissedAt
  // above. Set the first time a new org either finishes or skips the wizard, so
  // returning users always land straight on /dashboard.
  onboardingWizardSeenAt        DateTime?
  // Same pattern as onboardingWizardSeenAt -- controls only the auto-redirect into
  // /prayer-wall/setup the first time staff visits Prayer Wall with neither
  // prayerWallEnabled nor testimoniesEnabled on yet, not step progress (derived from
  // those same two flags). "Come back later" sets this without enabling anything, so
  // the auto-redirect never fires again, but PrayerWallModerationPage still shows a
  // persistent card linking back into the wizard for as long as neither is enabled.
  prayerTestimonyWizardSeenAt   DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  members                 OrganizationMember[]
  websites                Website[]
  widgets                 WidgetConfiguration[]
  resources               Resource[]
  resourceSourceDocuments ResourceSourceDocument[]
  generatedEvidence       GeneratedMetadataEvidence[]
  collections             Collection[]
  resourceCollections     ResourceCollection[]
  actionLinks             ActionLink[]
  organizationalLinks     OrganizationalLink[]
  importJobs              ImportJob[]
  importJobItems          ImportJobItem[]
  bulkJobs                BulkJob[]
  conversations           Conversation[]
  conversationMessages    ConversationMessage[]
  auditLogs               AuditLog[]
  contentSources          ContentSource[]
  prayerWallAccounts      PrayerWallAccount[]
  prayerRequests          PrayerRequest[]
  prayerWallResetTokens   PrayerWallPasswordResetToken[]
  testimonies             Testimony[]
}

enum CategorizationMode {
  MANUAL
  ASSISTED
  AUTOMATIC
}

/**
 * userId is @unique, not just part of a compound key -- product decision: one
 * organization per user account, no multi-org membership/switching (see
 * lib/session.ts's getCurrentOrganization). A row's own id is still the primary
 * key so this stays a normal join table shape rather than making userId the PK.
 */
model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String           @unique
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Websites & Widgets
// ---------------------------------------------------------------------------

enum WebsiteStatus {
  ACTIVE
  INACTIVE
}

model Website {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  primaryDomain  String
  allowedDomains String[]      @default([])
  stagingDomains String[]      @default([])
  status         WebsiteStatus @default(ACTIVE)
  // Campus-specific prayer wall (Multi-Site+ only, campusScopedPrayerWalls feature).
  // Mirrors Organization's 5 prayer-wall fields exactly -- the org-level wall stays
  // the default/fallback for every org unchanged; these are an additive per-campus
  // option, not a replacement. publicPrayerWallId is nullable+unique (not every
  // website has its own wall) unlike Organization's always-present version.
  prayerWallEnabled             Boolean  @default(false)
  publicPrayerWallId            String?  @unique
  prayerRequestForwardingEmails String[] @default([])
  prayerWallBrandColor          String?
  prayerWallLogoUrl             String?
  // Mirrors Organization's testimonies fields for the same reason as above.
  testimoniesEnabled            Boolean  @default(false)
  testimoniesPageName           String   @default("Praise Report")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets        WidgetConfiguration[]
  resources      Resource[]
  prayerRequests PrayerRequest[]
  testimonies    Testimony[]

  @@index([organizationId])
}

enum WidgetStatus {
  ACTIVE
  INACTIVE
}

enum LauncherPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

// Ten shell treatments widget-loader.js knows how to mount (see that file's
// buildXShell functions) -- launcherPosition still applies within the styles where
// left/right genuinely varies (BUBBLE, GREETER, LINK); the rest are inherently
// edge/center-anchored (SLIDE, TAB, DOCK, RIBBON, PALETTE, SHEET) or have no
// launcher at all (INLINE), and ignore it.
enum WidgetDisplayStyle {
  BUBBLE
  SLIDE
  INLINE
  DOCK
  PALETTE
  GREETER
  SHEET
  TAB
  RIBBON
  LINK
}

model WidgetConfiguration {
  id                        String           @id @default(cuid())
  organizationId            String
  websiteId                 String
  name                      String
  publicWidgetId            String           @unique @default(cuid())
  status                    WidgetStatus     @default(ACTIVE)
  assistantName             String           @default("Resource Assistant")
  welcomeMessage            String           @default("Hi! What are you looking for today?")
  inputPlaceholder          String           @default("Ask a question...")
  launcherLabel             String           @default("Ask a question")
  launcherPosition          LauncherPosition @default(BOTTOM_RIGHT)
  displayStyle              WidgetDisplayStyle @default(BUBBLE)
  primaryColor              String           @default("#161616")
  logoUrl                   String?
  suggestedPrompts          String[]         @default([])
  privacyNotice             String           @default("Conversations are anonymous and not linked to your identity.")
  noResultMessage           String           @default("I couldn't find a resource that directly addresses that yet.")
  maxRecommendations        Int              @default(3)
  allowInlinePlayback       Boolean          @default(true)
  showPlatformBranding      Boolean          @default(true)
  conversationRetentionDays Int              @default(30)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([organizationId])
  @@index([websiteId])
}

// ---------------------------------------------------------------------------
// Resources
// ---------------------------------------------------------------------------

enum ResourceType {
  VIDEO
  SERMON
  PODCAST
  ARTICLE
  COURSE
  DOCUMENT
  DEVOTIONAL
  AUDIO
  OTHER
}

enum ResourceStatus {
  DRAFT
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  ACTIVE
  INACTIVE
  FAILED
  ARCHIVED
}

enum ResourceProviderType {
  YOUTUBE
  VIMEO
  SUBSPLASH
  GENERIC_URL
  MANUAL
  RSS
}

enum TranscriptSource {
  PROVIDER_CAPTIONS
  UPLOADED_CAPTIONS
  MANUAL_TRANSCRIPT
  LINKED_NOTES
  AUTOMATIC_TRANSCRIPTION
  METADATA_ONLY
}

model Resource {
  id             String         @id @default(cuid())
  organizationId String
  // null = org-wide, available to every campus's widgets (the default for every org
  // today). Set = scoped to one campus/website's content library only -- Multi-Site+
  // only (campusScopedContentLibraries feature); see the retrieval provider's
  // candidate-resource filtering. onDelete: SetNull, not Cascade -- deleting a
  // website should never delete the org's resources, just unscope them back to
  // org-wide.
  websiteId      String?
  resourceType   ResourceType
  status         ResourceStatus @default(DRAFT)

  title       String
  subtitle    String?
  description String?
  summary     String?

  creatorName     String?
  speakerName     String?
  seriesTitle     String?
  publishedAt     DateTime?
  durationSeconds Int?
  thumbnailUrl    String?
  publicUrl       String
  embedUrl        String?

  sourceProvider ResourceProviderType
  externalId     String

  transcript       String?
  cleanTranscript  String?
  transcriptSource TranscriptSource?

  topics            String[] @default([])
  primaryTopic      String?
  secondaryTopics   String[] @default([])
  scriptures        String[] @default([])
  questionsAnswered String[] @default([])
  audiences         String[] @default([])
  lifeSituations    String[] @default([])
  keyTakeaways      String[] @default([])

  searchDocument String?
  contentHash    String?
  lastIndexedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website         Website?                    @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  sourceDocuments ResourceSourceDocument[]
  evidence        GeneratedMetadataEvidence[]
  collections     ResourceCollection[]
  importJobItems  ImportJobItem[]

  @@unique([organizationId, sourceProvider, externalId])
  @@index([organizationId, status])
  @@index([websiteId])
}

enum SourceDocumentType {
  VIDEO_DESCRIPTION
  PROVIDER_METADATA
  TRANSCRIPT
  CAPTION_FILE
  SERMON_NOTES
  PDF
  WEB_PAGE
  MANUAL_NOTES
  OTHER
}

model ResourceSourceDocument {
  id                      String             @id @default(cuid())
  organizationId          String
  resourceId              String
  sourceType              SourceDocumentType
  sourceUrl               String?
  fileName                String?
  originalText            String?
  cleanText               String?
  includedInAnalysis      Boolean            @default(true)
  approvedByUser          Boolean            @default(false)
  discoveredAutomatically Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource                    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  evidence     GeneratedMetadataEvidence[]

  @@index([organizationId])
  @@index([resourceId])
}

model GeneratedMetadataEvidence {
  id               String   @id @default(cuid())
  organizationId   String
  resourceId       String
  fieldName        String
  generatedValue   String
  sourceDocumentId String?
  sourceExcerpt    String?
  confidenceScore  Float
  createdAt        DateTime @default(now())

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       Resource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sourceDocument ResourceSourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([resourceId])
}

model Collection {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    ResourceCollection[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ResourceCollection {
  organizationId String
  resourceId     String
  collectionId   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([resourceId, collectionId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Imports
// ---------------------------------------------------------------------------

enum ImportType {
  SINGLE
  PLAYLIST
  CHANNEL
  MANUAL
  FEED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model ImportJob {
  id             String               @id @default(cuid())
  organizationId String
  provider       ResourceProviderType
  importType     ImportType
  status         ImportJobStatus      @default(PENDING)
  totalItems     Int                  @default(0)
  successCount   Int                  @default(0)
  failureCount   Int                  @default(0)
  errorLog       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ImportJobItem[]

  @@index([organizationId])
}

model ImportJobItem {
  id             String   @id @default(cuid())
  organizationId String
  importJobId    String
  resourceId     String?
  sourceUrl      String
  success        Boolean  @default(false)
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importJob    ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  resource     Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([importJobId])
}

enum BulkJobType {
  ANALYZE
  APPROVE
  REJECT
  DELETE
  FIND_LINKS
  INCLUDE_LINKS
}

enum BulkJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/**
 * Tracks a Resources-page bulk-toolbar action (one row per click, not per resource)
 * so the Server Action that enqueues it can return immediately -- the actual work
 * runs after the response via next/server's after(), and the client polls this row's
 * progress instead of the request blocking until every resource is processed. No
 * child item table: the existing per-action AuditLog entry already records
 * resourceIds, and the UI only needs an aggregate progress bar + one summary line.
 */
model BulkJob {
  id              String        @id @default(cuid())
  organizationId  String
  type            BulkJobType
  status          BulkJobStatus @default(PENDING)
  resourceIds     String[]
  totalCount      Int
  processedCount  Int           @default(0)
  successCount    Int           @default(0)
  failureCount    Int           @default(0)
  // Exactly which of resourceIds are done so far -- not derivable from processedCount
  // alone once work resumes across multiple chunked invocations (see
  // resource-pipeline.ts's runBulkJob), since concurrent workers can finish items out
  // of resourceIds' original order.
  processedResourceIds String[] @default([])
  // FIND_LINKS/INCLUDE_LINKS-specific running total (links discovered / links
  // included) folded into resultSummary once the job fully completes -- generic
  // rather than two separate fields since only one job type's summary needs it at a
  // time.
  extraCount      Int           @default(0)
  resultSummary   String?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}

/**
 * A tracked YouTube channel or RSS feed that should be periodically re-checked for
 * new content. provider is restricted at the service layer to YOUTUBE | RSS (the two
 * providers with listResources()/bulk import support) even though it reuses the
 * broader ResourceProviderType enum. Sync itself reruns the same
 * importYouTubeChannel/importRSSFeed bulk-import path used for the one-off import
 * forms, so re-imported items are deduped the same way (organizationId +
 * sourceProvider + externalId).
 */
model ContentSource {
  id              String               @id @default(cuid())
  organizationId  String
  provider        ResourceProviderType
  sourceUrl       String
  label           String?
  autoSyncEnabled Boolean              @default(true)
  autoApprove     Boolean              @default(false)
  lastSyncedAt    DateTime?
  lastSyncStatus  ImportJobStatus?
  lastSyncError   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, sourceUrl])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  widgetId       String
  sessionId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widget       WidgetConfiguration   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]

  @@index([organizationId])
  @@index([widgetId, sessionId])
}

enum MessageRole {
  USER
  ASSISTANT
}

model ConversationMessage {
  id                     String      @id @default(cuid())
  organizationId         String
  conversationId         String
  role                   MessageRole
  content                String
  responseType           String?
  recommendedResourceIds String[]    @default([])
  createdAt              DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Actions, Audit
// ---------------------------------------------------------------------------

/** Quick-action buttons shown alongside the chat when a visitor opens the widget (Give, Contact, Service times, ...). Display-only -- never matched against a visitor's chat message, see OrganizationalLink for that. */
model ActionLink {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  type           String
  url            String
  icon           String?
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/**
 * Site links the chat assistant can answer navigational questions with -- "where can
 * I find the notes?" -- deliberately separate from ActionLink: those are quick-action
 * buttons always visible in the widget UI, curated for what a visitor should be able
 * to tap; these are never shown as buttons, only ever surfaced when a visitor's
 * question specifically calls for one (see ChatPipeline's link-matching step).
 * Managed from the Resources page, not the widget's Standard Links box, since they're
 * conceptually closer to "things the assistant knows about" than to widget chrome.
 */
model OrganizationalLink {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  url            String
  // What this link is for, e.g. "This week's sermon notes and study guide." Never
  // shown to visitors -- purely what the matching step compares a visitor's message
  // against, alongside the label.
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Prayer wall
// ---------------------------------------------------------------------------

/**
 * A public-site visitor's account, scoped to one organization -- the same email can have separate accounts at different churches.
 */
model PrayerWallAccount {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  displayName    String?
  createdAt      DateTime @default(now())

  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       PrayerWallSession[]
  prayerRequests PrayerRequest[]
  resetTokens    PrayerWallPasswordResetToken[]
  testimonies    Testimony[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

/**
 * Opaque bearer-token session for a PrayerWallAccount. Deliberately NOT tenant-scoped
 * (no organizationId column) -- the token itself is the lookup key used to resolve
 * identity before any organizationId is known, the same boundary as User/
 * getWidgetByPublicId. Accessed only via rawDb in prayer-service.ts.
 */
model PrayerWallSession {
  id        String   @id @default(cuid())
  accountId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  account PrayerWallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/**
 * Unlike PrayerWallSession, this IS tenant-scoped (organizationId present, queried via
 * tenantDb) -- the reset flow always starts from /prayer/[publicPrayerWallId]/..., so
 * the organization is already known before a token is ever issued or looked up, none
 * of the "resolve identity before organizationId is known" bootstrapping problem
 * PrayerWallSession has. Single-use and short-lived, same as PasswordResetToken.
 */
model PrayerWallPasswordResetToken {
  id             String   @id @default(cuid())
  organizationId String
  accountId      String
  token          String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      PrayerWallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([accountId])
}

enum PrayerRequestStatus {
  SUBMITTED
  ANSWERED
}

// Fixed set for v1, not per-org customizable -- see the plan doc's explicit
// non-goal. Only offered on the public submit form when the org's plan has the
// prayerCategories feature; otherwise the field stays null.
enum PrayerRequestCategory {
  HEALTH
  FAMILY
  FINANCIAL
  SPIRITUAL_GROWTH
  GRIEF_LOSS
  GUIDANCE
  OTHER
}

model PrayerRequest {
  id             String                 @id @default(cuid())
  organizationId String
  accountId      String
  // null = submitted via the org-level default wall. Set = submitted via a specific
  // campus's wall (Website.prayerWallEnabled) -- determines which campus's forwarding
  // emails fire and which public wall page lists it. onDelete: SetNull, not Cascade --
  // deleting a website's wall config should never delete the requests made through it.
  websiteId      String?
  message        String
  isPublic       Boolean                @default(false)
  isAnonymous    Boolean                @default(false)
  publicizedAt   DateTime?
  status         PrayerRequestStatus    @default(SUBMITTED)
  category       PrayerRequestCategory?
  // Staff-only, never rendered on any public/submitter-facing page -- set via the
  // prayer moderation page (requires internalPrayerNotes entitlement).
  internalNotes  String?
  prayerCount    Int                    @default(0)
  answeredAt     DateTime?
  forwardedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      PrayerWallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  website      Website?          @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([accountId])
  @@index([websiteId])
}

/**
 * A "praise report" -- either a visitor submission (accountId set, isFeatured
 * false) or a staff-curated highlight (createdByUserId set, isFeatured true,
 * optionally with an embedded YouTube video). One model for both because they
 * render on the same public list; isFeatured is what the service layer uses to
 * decide which fields a given caller is allowed to set.
 */
model Testimony {
  id             String   @id @default(cuid())
  organizationId String
  // Same convention as PrayerRequest.websiteId: null = org-level default wall,
  // set = a specific campus's wall. onDelete: SetNull for the same reason.
  websiteId      String?
  // Set for visitor submissions; null for staff-added featured testimonies.
  // onDelete: SetNull (not Cascade like PrayerRequest.accountId) -- a testimony is
  // durable public content that shouldn't vanish just because the submitter's
  // login was later removed.
  accountId      String?
  message        String
  // Only ever set on isFeatured rows -- visitor submissions attribute via the
  // account relation instead (display name/email), same pattern as
  // PrayerRequest.isAnonymous controlling attribution at render time.
  authorDisplayName String?
  isFeatured     Boolean  @default(false)
  // Visitor submissions publish immediately (no pre-approval queue); staff can
  // hide via this flag afterward through the moderation page. Featured
  // testimonies default to public too.
  isPublic       Boolean  @default(true)
  // Only ever set on isFeatured rows. Stored as both the raw URL (so the admin
  // edit form can prefill it) and pre-computed at write time -- same "store
  // both, never parse on read" pattern as YouTubeProvider.ts.
  youtubeUrl      String?
  youtubeVideoId  String?
  youtubeEmbedUrl String?
  // Display order among isFeatured rows only (ActionLink.order pattern) --
  // visitor submissions always sort by createdAt instead.
  order          Int      @default(0)
  // Staff member who added a featured testimony. onDelete: SetNull for the same
  // durable-public-content reasoning as accountId above.
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website?           @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  account      PrayerWallAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([accountId])
  @@index([websiteId])
}
